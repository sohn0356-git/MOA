{
  "rules": {
    "verse": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "verseMeta": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
