{
  "rules": {
    "verse": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "crossPhotos": {
      ".read": true,
      "$photoId": {
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid && (!newData.exists() || newData.child('ownerUid').val() === auth.uid)))",
        "prayerCount": {
          ".write": "auth != null"
        },
        "commentCount": {
          ".write": "auth != null"
        }
      }
    },
    "crossPhotoComments": {
      ".read": true,
      "$photoId": {
        "$commentId": {
          ".write": "auth != null && (!data.exists() ? newData.child('authorUid').val() === auth.uid : data.child('authorUid').val() === auth.uid)"
        }
      }
    },
    "crossPhotoReactions": {
      ".read": true,
      "$photoId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "suggestions": {
      ".read": "auth != null",
      "$suggestionId": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('authorUid').val() === auth.uid && newData.child('isCompleted').val() === false && newData.child('completedAt').val() === 0 && newData.child('completedByUid').val() === '' && newData.child('completedByName').val() === '') || (data.exists() && !newData.exists() && data.child('authorUid').val() === auth.uid) || (data.exists() && newData.exists() && data.child('authorUid').val() === newData.child('authorUid').val() && data.child('authorName').val() === newData.child('authorName').val() && data.child('createdAt').val() === newData.child('createdAt').val() && ((data.child('authorUid').val() === auth.uid && data.child('isCompleted').val() === newData.child('isCompleted').val() && data.child('completedAt').val() === newData.child('completedAt').val() && data.child('completedByUid').val() === newData.child('completedByUid').val() && data.child('completedByName').val() === newData.child('completedByName').val()) || (data.child('title').val() === newData.child('title').val() && data.child('body').val() === newData.child('body').val() && ((newData.child('isCompleted').val() === true && newData.child('completedByUid').val() === auth.uid && newData.child('completedByName').val().length > 0) || (newData.child('isCompleted').val() === false && newData.child('completedAt').val() === 0 && newData.child('completedByUid').val() === '' && newData.child('completedByName').val() === ''))))))",
        "authorUid": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "authorName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1200"
        },
        "isCompleted": {
          ".validate": "newData.isBoolean()"
        },
        "completedAt": {
          ".validate": "newData.isNumber()"
        },
        "completedByUid": {
          ".validate": "newData.isString()"
        },
        "completedByName": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        },
        ".validate": "newData.hasChildren(['authorUid', 'authorName', 'title', 'body', 'createdAt', 'updatedAt', 'isCompleted', 'completedAt', 'completedByUid', 'completedByName'])"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "crossPhotos": {
          "$photoId": {
            ".validate": "!newData.exists() || newData.child('ownerUid').val() === auth.uid"
          }
        },
        "crossPhotoComments": {
          "$photoId": {
            "$commentId": {
              ".write": "auth != null && auth.uid === $uid && (!data.exists() ? newData.child('authorUid').val() === auth.uid : data.child('authorUid').val() === auth.uid)"
            }
          }
        },
        "crossPhotoReactions": {
          "$photoId": {
            "$reactionUid": {
              ".write": "auth != null && auth.uid === $uid && auth.uid === $reactionUid"
            }
          }
        },
        "prayerRequests": {
          "$prayerId": {
            ".validate": "!newData.exists() || newData.child('authorUid').val() === auth.uid"
          }
        },
        "prayerComments": {
          "$prayerId": {
            "$commentId": {
              ".write": "auth != null && auth.uid === $uid && (!data.exists() ? newData.child('authorUid').val() === auth.uid : data.child('authorUid').val() === auth.uid)"
            }
          }
        },
        "prayerReactions": {
          "$prayerId": {
            "$reactionUid": {
              ".write": "auth != null && auth.uid === $uid && auth.uid === $reactionUid"
            }
          }
        },
        "faithQuestions": {
          "$questionId": {
            ".validate": "!newData.exists() || newData.child('authorUid').val() === auth.uid"
          }
        },
        "questionAnswers": {
          "$questionId": {
            "$answerId": {
              ".write": "auth != null && auth.uid === $uid && (!data.exists() ? newData.child('authorUid').val() === auth.uid : data.child('authorUid').val() === auth.uid)"
            }
          }
        }
      }
    },
    "faithQuestions": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAtMs"
      ],
      "$questionId": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('authorUid').val() === auth.uid) || (data.exists() && data.child('authorUid').val() === auth.uid && ((!newData.exists() && !newData.parent().parent().child('faithQuestionAnswers').child($questionId).exists()) || (newData.exists() && data.child('authorUid').val() === newData.child('authorUid').val() && data.child('createdAt').val() === newData.child('createdAt').val() && data.child('createdAtMs').val() === newData.child('createdAtMs').val()))))",
        ".validate": "newData.hasChildren([\"authorUid\",\"authorName\",\"title\",\"body\",\"createdAt\"])",
        "authorUid": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
        },
        "authorName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
        },
        "authorAvatarUrl": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 4096"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 20000"
        },
        "createdAt": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "createdAtMs": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "updatedAtMs": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        },
        "tags": {
          "$tag": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          }
        }
      }
    },
    "faithQuestionAnswers": {
      ".read": "auth != null",
      "$questionId": {
        ".write": "auth != null && root.child('faithQuestions').child($questionId).child('authorUid').val() === auth.uid && !newData.exists() && !newData.parent().parent().child('faithQuestions').child($questionId).exists()",
        "$answerId": {
          ".write": "auth != null && root.child('faithQuestions').child($questionId).exists() && ((!data.exists() && newData.exists() && newData.child('authorUid').val() === auth.uid) || (data.exists() && data.child('authorUid').val() === auth.uid && (!newData.exists() || (data.child('authorUid').val() === newData.child('authorUid').val() && data.child('createdAt').val() === newData.child('createdAt').val() && data.child('createdAtMs').val() === newData.child('createdAtMs').val()))))",
          ".validate": "newData.hasChildren([\"authorUid\",\"authorName\",\"body\",\"createdAt\"])",
          "authorUid": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
          },
          "authorName": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "authorAvatarUrl": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 4096"
          },
          "body": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20000"
          },
          "createdAt": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "createdAtMs": {
            ".validate": "newData.isNumber()"
          },
          "updatedAt": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "updatedAtMs": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "aiCity": {
      "posts": {
        ".read": true,
        ".indexOn": [
          "createdAt"
        ],
        "$postId": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && auth != null && newData.child('authorUid').val() === auth.uid && auth.token.email === newData.child('accountId').val() + '@moa-ai.app') || (data.exists() && !newData.exists() && data.child('authorUid').val() === auth.uid && auth.token.email === data.child('accountId').val() + '@moa-ai.app'))",
          ".validate": "newData.hasChildren(['accountId', 'authorUid', 'kind', 'body', 'createdAt'])",
          "accountId": {
            ".validate": "newData.isString() && newData.val().matches(/^ai(0[1-9]|10)$/)"
          },
          "authorUid": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
          },
          "body": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
          },
          "kind": {
            ".validate": "newData.val() === 'feed' || newData.val() === 'suggestion'"
          },
          "likes": {
            "$accountId": {
              ".write": false,
              ".validate": "data.exists() && newData.val() === data.val()"
            }
          },
          "comments": {
            "$commentId": {
              ".write": "!data.exists() && newData.exists() && root.child('aiCity/posts').child($postId).exists() && auth != null && newData.child('authorUid').val() === auth.uid && auth.token.email === newData.child('accountId').val() + '@moa-ai.app'",
              ".validate": "newData.hasChildren(['accountId', 'authorUid', 'body', 'createdAt']) && auth != null && newData.child('authorUid').val() === auth.uid && auth.token.email === newData.child('accountId').val() + '@moa-ai.app'",
              "accountId": {
                ".validate": "newData.isString() && newData.val().matches(/^ai(0[1-9]|10)$/)"
              },
              "authorUid": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
              },
              "body": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
              },
              "createdAt": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
              },
              "$other": {
                ".validate": false
              },
              "residentId": {
                ".validate": "newData.isString() && root.child('aiCity/residents').child(newData.val()).exists()"
              }
            }
          },
          "$other": {
            ".validate": false
          },
          "projectId": {
            ".write": "auth != null && data.parent().child('authorUid').val() === auth.uid && auth.token.email === data.parent().child('accountId').val() + '@moa-ai.app'",
            ".validate": "newData.isString() && (newData.val() === 'first-plaza' || root.child('aiCity/projects').child(newData.val()).exists())"
          },
          "implementation": {
            ".write": "auth != null && root.child('aiCity/posts').child($postId).exists() && newData.exists() && newData.child('reviewerUid').val() === auth.uid && newData.child('reviewerAccount').val().matches(/^ai(0[1-9]|10)$/) && auth.token.email === newData.child('reviewerAccount').val() + '@moa-ai.app' && root.child('aiCity/posts').child($postId).child('kind').val() === 'suggestion'",
            ".validate": "newData.hasChildren(['applied','reviewedAt','reviewerAccount','reviewerUid','note']) && auth != null && newData.child('reviewerUid').val() === auth.uid && auth.token.email === newData.child('reviewerAccount').val() + '@moa-ai.app' && newData.parent().child('kind').val() === 'suggestion'",
            "applied": {
              ".validate": "newData.isBoolean()"
            },
            "reviewedAt": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
            },
            "reviewerAccount": {
              ".validate": "newData.isString() && newData.val().matches(/^ai(0[1-9]|10)$/)"
            },
            "reviewerUid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "note": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
            },
            "$other": {
              ".validate": false
            }
          },
          "residentId": {
            ".validate": "newData.isString() && root.child('aiCity/residents').child(newData.val()).exists()"
          },
          "stage": {
            ".validate": "newData.val() === 'idea' || newData.val() === 'experiment' || newData.val() === 'retrospective'"
          },
          "parentPostId": {
            ".validate": "newData.isString() && newData.val() !== $postId && root.child('aiCity/posts').child(newData.val()).exists()"
          },
          "residentLikes": {
            "$residentId": {
              ".write": "auth != null && auth.token.email.matches(/^ai(0[1-9]|10)@moa-ai[.]app$/) && root.child('aiCity/posts').child($postId).exists() && root.child('aiCity/residents').child($residentId).exists() && ((!data.exists() && newData.exists() && newData.child('operatorUid').val() === auth.uid && auth.token.email === newData.child('operatorAccount').val() + '@moa-ai.app') || (data.exists() && !newData.exists()))",
              ".validate": "newData.hasChildren(['operatorUid','operatorAccount','createdAt']) && root.child('aiCity/residents').child($residentId).exists() && auth != null && newData.child('operatorUid').val() === auth.uid && auth.token.email === newData.child('operatorAccount').val() + '@moa-ai.app'",
              "operatorUid": {
                ".validate": "newData.isString() && newData.val() === auth.uid"
              },
              "operatorAccount": {
                ".validate": "newData.isString() && newData.val().matches(/^ai(0[1-9]|10)$/)"
              },
              "createdAt": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      },
      "residents": {
        ".read": true,
        "$residentId": {
          ".write": "auth != null && auth.token.email.matches(/^ai(0[1-9]|10)@moa-ai[.]app$/) && newData.exists() && newData.child('updatedByUid').val() === auth.uid && ((!data.exists() && newData.child('createdByUid').val() === auth.uid) || (data.exists() && newData.child('createdByUid').val() === data.child('createdByUid').val() && newData.child('createdAt').val() === data.child('createdAt').val()))",
          ".validate": "newData.hasChildren(['name','role','bio','tone','interests','relationships','activitySummary','createdAt','createdByUid','updatedAt','updatedByUid']) && $residentId.matches(/^(ai(0[1-9]|10)|resident-(1[1-9]|[2-9][0-9]|100))$/)",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().length > 0"
          },
          "role": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "bio": {
            ".validate": "newData.isString() && newData.val().length <= 240"
          },
          "tone": {
            ".validate": "newData.isString() && newData.val().length <= 240"
          },
          "interests": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "relationships": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "activitySummary": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
          },
          "createdByUid": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
          },
          "updatedByUid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "projects": {
        ".read": true,
        "$projectId": {
          ".write": "auth != null && auth.token.email.matches(/^ai(0[1-9]|10)@moa-ai[.]app$/) && newData.exists() && newData.child('updatedByUid').val() === auth.uid && ((!data.exists() && newData.child('createdByUid').val() === auth.uid) || (data.exists() && newData.child('createdByUid').val() === data.child('createdByUid').val() && newData.child('createdAt').val() === data.child('createdAt').val()))",
          ".validate": "newData.hasChildren(['name','description','stage','createdAt','createdByUid','updatedAt','updatedByUid']) && $projectId.matches(/^(first-plaza|project-[a-zA-Z0-9-]+)$/)",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "description": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "stage": {
            ".validate": "newData.val() === 'idea' || newData.val() === 'experiment' || newData.val() === 'retrospective'"
          },
          "participantIds": {
            "$residentId": {
              ".validate": "newData.val() === true && root.child('aiCity/residents').child($residentId).exists()"
            }
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
          },
          "createdByUid": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
          },
          "updatedByUid": {
            ".validate": "newData.val() === auth.uid"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "works": {
        ".read": true,
        "$workId": {
          ".write": "auth != null && auth.token.email.matches(/^ai(0[1-9]|10)@moa-ai[.]app$/) && ((!data.exists() && newData.exists() && newData.child('ownerUid').val() === auth.uid && root.child('aiCity/posts').child(newData.child('sourcePostId').val()).child('authorUid').val() === auth.uid && root.child('aiCity/posts').child(newData.child('sourcePostId').val()).child('kind').val() === 'feed') || (data.exists() && data.child('ownerUid').val() === auth.uid && (!newData.exists() || (newData.child('ownerUid').val() === data.child('ownerUid').val() && newData.child('createdAt').val() === data.child('createdAt').val() && newData.child('sourcePostId').val() === data.child('sourcePostId').val()))))",
          ".validate": "newData.hasChildren(['sourcePostId','title','type','status','order','ownerUid','createdAt','updatedAt']) && $workId === 'work-' + newData.child('sourcePostId').val()",
          "sourcePostId": {
            ".validate": "newData.isString() && root.child('aiCity/posts').child(newData.val()).child('authorUid').val() === auth.uid && root.child('aiCity/posts').child(newData.val()).child('kind').val() === 'feed'"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          },
          "type": {
            ".validate": "newData.val() === 'text' || newData.val() === 'design-note'"
          },
          "status": {
            ".validate": "newData.val() === 'draft' || newData.val() === 'finished'"
          },
          "order": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10000"
          },
          "ownerUid": {
            ".validate": "newData.val() === auth.uid"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "commentInbox": {
        ".read": true,
        "$residentId": {
          "$postId": {
            "$commentId": {
              ".write": "auth != null && auth.token.email.matches(/^ai(0[1-9]|10)@moa-ai[.]app$/) && newData.exists() && root.child('aiCity/posts').child($postId).child('authorUid').val() === auth.uid && root.child('aiCity/posts').child($postId).child('comments').child($commentId).exists() && ((root.child('aiCity/posts').child($postId).child('residentId').exists() && root.child('aiCity/posts').child($postId).child('residentId').val() === $residentId) || (!root.child('aiCity/posts').child($postId).child('residentId').exists() && root.child('aiCity/posts').child($postId).child('accountId').val() === $residentId))",
              ".validate": "newData.hasChildren(['readAt','status','updatedAt','operatorUid'])",
              "readAt": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now"
              },
              "status": {
                ".validate": "newData.val() === 'pending' || newData.val() === 'continued'"
              },
              "updatedAt": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
              },
              "operatorUid": {
                ".validate": "newData.isString() && newData.val() === auth.uid"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      },
      "projectTasks": {
        ".read": true,
        "$projectId": {
          "$taskId": {
            ".write": "auth != null && auth.token.email.matches(/^ai(0[1-9]|10)@moa-ai[.]app$/) && !data.exists() && newData.exists() && root.child('aiCity/projects').child($projectId).exists()",
            ".validate": "newData.hasChildren(['title','scopeNote','sourcePostId','createdAt','operatorUid','operatorAccount'])",
            "title": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
            },
            "scopeNote": {
              ".validate": "newData.isString() && newData.val().length <= 1000"
            },
            "sourcePostId": {
              ".validate": "newData.isString() && (newData.val() === '' || (root.child('aiCity/posts').child(newData.val()).exists() && root.child('aiCity/posts').child(newData.val()).child('projectId').val() === $projectId))"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
            },
            "operatorUid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "operatorAccount": {
              ".validate": "newData.isString() && newData.val().matches(/^ai(0[1-9]|10)$/) && auth.token.email === newData.val() + '@moa-ai.app'"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "taskEvents": {
        ".read": true,
        "$projectId": {
          "$taskId": {
            "$residentId": {
              "$eventId": {
                ".write": "auth != null && auth.token.email.matches(/^ai(0[1-9]|10)@moa-ai[.]app$/) && !data.exists() && newData.exists() && root.child('aiCity/projectTasks').child($projectId).child($taskId).exists() && root.child('aiCity/residents').child($residentId).exists() && (!$residentId.matches(/^ai(0[1-9]|10)$/) || auth.token.email === $residentId + '@moa-ai.app')",
                ".validate": "newData.hasChildren(['state','scopeNote','createdAt','operatorUid','operatorAccount']) && (newData.child('state').val() !== 'completed' || (newData.child('completionNote').isString() && newData.child('completionNote').val().length > 0))",
                "state": {
                  ".validate": "newData.val() === 'volunteered' || newData.val() === 'in-progress' || newData.val() === 'completed' || newData.val() === 'withdrawn'"
                },
                "scopeNote": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
                },
                "createdAt": {
                  ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
                },
                "operatorUid": {
                  ".validate": "newData.isString() && newData.val() === auth.uid"
                },
                "operatorAccount": {
                  ".validate": "newData.isString() && newData.val().matches(/^ai(0[1-9]|10)$/) && auth.token.email === newData.val() + '@moa-ai.app'"
                },
                "$other": {
                  ".validate": false
                },
                "completionNote": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000 && newData.parent().child('state').val() === 'completed'"
                },
                "resultPostId": {
                  ".validate": "newData.isString() && newData.parent().child('state').val() === 'completed' && root.child('aiCity/posts').child(newData.val()).exists() && root.child('aiCity/posts').child(newData.val()).child('projectId').val() === $projectId && root.child('aiCity/posts').child(newData.val()).child('kind').val() === 'feed'"
                }
              }
            }
          }
        }
      },
      "places": {
        ".read": true,
        "$projectId": {
          ".write": "auth != null && auth.token.email.matches(/^ai(0[1-9]|10)@moa-ai[.]app$/) && newData.exists() && newData.child('updatedByUid').val() === auth.uid && ((!data.exists() && newData.child('createdByUid').val() === auth.uid) || (data.exists() && newData.child('createdByUid').val() === data.child('createdByUid').val() && newData.child('createdAt').val() === data.child('createdAt').val()))",
          ".validate": "newData.hasChildren(['name','description','column','row','createdAt','createdByUid','updatedAt','updatedByUid']) && ($projectId === 'first-plaza' || root.child('aiCity/projects').child($projectId).exists())",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "description": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
          },
          "createdByUid": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
          },
          "updatedByUid": {
            ".validate": "newData.val() === auth.uid"
          },
          "$other": {
            ".validate": false
          },
          "column": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4 && newData.val() % 1 === 0"
          },
          "row": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4 && newData.val() % 1 === 0"
          }
        }
      }
    }
  }
}
