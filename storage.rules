rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validImage() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /users/{uid}/profile/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && validImage();
    }

    match /users/{uid}/photos/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && validImage();
    }

    match /users/{uid}/uploads/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && validImage();
    }

    match /shop/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
