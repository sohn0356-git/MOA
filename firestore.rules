rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function friendshipId(a, b) {
      return a < b ? a + "_" + b : b + "_" + a;
    }

    function isFriend(a, b) {
      return signedIn()
        && exists(/databases/$(database)/documents/friendships/$(friendshipId(a, b)))
        && get(/databases/$(database)/documents/friendships/$(friendshipId(a, b))).data.status == "accepted";
    }

    function visible(ownerUid, visibility) {
      return visibility == "public"
        || isOwner(ownerUid)
        || (visibility == "friends" && isFriend(ownerUid, request.auth.uid));
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.usernameLowercase is string;
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "uid",
          "username",
          "usernameLowercase",
          "friendCount",
          "todayVisitors",
          "totalVisitors",
          "createdAt"
        ]);
      allow delete: if false;

      match /private/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /inventory/{itemId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow create: if false;
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
        allow delete: if isOwner(uid);
      }

      match /walletTransactions/{transactionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /playlists/{playlistId} {
        allow read, write: if isOwner(uid);
      }

      match /miniroom/{docId} {
        allow read: if true;
        allow write: if isOwner(uid) && docId == "layout";
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /diaryPosts/{postId} {
      allow read: if visible(resource.data.ownerUid, resource.data.visibility);
      allow create: if isOwner(request.resource.data.ownerUid);
      allow update, delete: if isOwner(resource.data.ownerUid);

      match /comments/{commentId} {
        allow read: if visible(get(/databases/$(database)/documents/diaryPosts/$(postId)).data.ownerUid,
          get(/databases/$(database)/documents/diaryPosts/$(postId)).data.visibility);
        allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isOwner(resource.data.authorUid);
      }
    }

    match /albums/{albumId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.ownerUid);
      allow update, delete: if isOwner(resource.data.ownerUid);
    }

    match /photos/{photoId} {
      allow read: if visible(resource.data.ownerUid, resource.data.visibility);
      allow create: if isOwner(request.resource.data.ownerUid);
      allow update, delete: if isOwner(resource.data.ownerUid);

      match /comments/{commentId} {
        allow read: if visible(get(/databases/$(database)/documents/photos/$(photoId)).data.ownerUid,
          get(/databases/$(database)/documents/photos/$(photoId)).data.visibility);
        allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isOwner(resource.data.authorUid);
      }
    }

    match /guestbookEntries/{entryId} {
      allow read: if resource.data.visibility == "public"
        || isOwner(resource.data.ownerUid)
        || isOwner(resource.data.authorUid);
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isOwner(resource.data.ownerUid);
      allow delete: if isOwner(resource.data.ownerUid) || isOwner(resource.data.authorUid);
    }

    match /shopItems/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    match /musicTracks/{trackId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /homepageVisits/{visitId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    match /reactions/{reactionId} {
      allow read: if true;
      allow create, update, delete: if signedIn() && request.resource.data.userUid == request.auth.uid;
    }
  }
}
